{
  "$schema": "https://unpkg.com/syncpack@14/schema.json",
  "semverGroups": [
    {
      "label": "Allow additive peer compatibility ranges",
      "dependencyTypes": ["peer"],
      "specifierTypes": ["range-complex"],
      "isIgnored": true
    },
    {
      "label": "Enforce pinned versions (no ^ or ~)",
      "dependencies": ["**"],
      "dependencyTypes": ["prod", "dev"],
      "packages": ["**"],
      "range": ""
    },
    {
      "label": "Enforce caret ranges for peers",
      "dependencies": ["**"],
      "dependencyTypes": ["peer"],
      "packages": ["**"],
      "range": "^"
    }
  ],
  "versionGroups": [
    {
      "label": "Allow Concerto peers to support multiple major versions",
      "dependencies": [
        "@accordproject/concerto-core",
        "@accordproject/concerto-util",
        "@accordproject/concerto-vocabulary"
      ],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    }
  ]
}
