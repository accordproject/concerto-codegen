        "type": "compiled"
    },
    "rust": {
        "cli": "Rust",
        "baseImage": "rust:alpine",
        "tool": "cargo check",
        "type": "compiled"
    },
    "java": {
        "cli": "Java",
        "baseImage": "eclipse-temurin:17-jdk-alpine",
