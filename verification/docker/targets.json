        "tool": "tsc --noEmit",
        "type": "compiled"
    },
    "jsonschema": {
        "cli": "JSONSchema",
        "baseImage": "node:20-alpine",
        "tool": "ajv compile",
        "type": "schema"
    },
    "graphql": {
        "cli": "GraphQL",
        "baseImage": "node:20-alpine",
        "tool": "graphql buildSchema",
        "type": "schema"
    },
    "protobuf": {
        "cli": "Protobuf",
        "baseImage": "node:20-alpine",
        "tool": "protoc",
        "type": "schema"
    },
    "csharp": {
        "cli": "CSharp",
        "baseImage": "dotnet/sdk:8.0-alpine",
